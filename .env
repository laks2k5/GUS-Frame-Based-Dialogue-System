# ── Flask ──────────────────────────────────────────────────────
FLASK_ENV=development
SECRET_KEY=change-this-to-a-long-random-string-in-production
PORT=5001
DB_PATH=gus.db
ALLOWED_ORIGINS=http://localhost:5000
JWT_EXPIRY_HOURS=24

# ── Amadeus API (Flights) ───────────────────────────────────────
# 1. Register FREE at https://developers.amadeus.com/
# 2. Create a "Self-Service" app (no credit card needed for test tier)
# 3. Copy Client ID + Client Secret below
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_HOSTNAME=test        # keep 'test' until you go live

# ── Railway API (Indian Trains) ─────────────────────────────────
# Option A — RailwayAPI.com (commercial, most reliable)
#   Register: https://www.railwayapi.com/
RAILWAY_API_KEY=

# Option B — RapidAPI Indian Railways (alternative)
#   Subscribe at: https://rapidapi.com/search/Indian+Railway
RAPIDAPI_KEY=
RAPIDAPI_RAILWAY_HOST=indian-railway-irctc.p.rapidapi.com

# ── Bus API ─────────────────────────────────────────────────────
# No public Indian bus API exists. Options:
#   RedBus partner: partner@redbus.in  (business agreement required)
#   AbhiBus:        technology@abhibus.com (enterprise only)
#
# Set BUS_USE_MOCK=true to enable realistic sample data for development.
BUS_USE_MOCK=true
BUS_API_KEY=

# ── Razorpay (Payment Gateway) ──────────────────────────────────
# 1. Register at https://razorpay.com/
# 2. Settings → API Keys → Generate Test Key
# Test cards: https://razorpay.com/docs/payments/payments/test-card-upi-details/
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
OPENAI_API_KEY=